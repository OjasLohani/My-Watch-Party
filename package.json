{
  "name": "watch-party",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.ts\" \"supabase/tests/*.test.mjs\"",
    "test:unit": "node --test \"tests/*.test.ts\"",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "test:concurrency": "node --test --test-concurrency=1 \"supabase/tests/*.pg.test.mjs\"",
    "check:videos": "node scripts/check-video-sources.mjs",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.browser.mjs\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "pg": "8.23.0",
    "puppeteer-core": "25.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
